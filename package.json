{
  "name": "mybook",
  "version": "0.3.9",
  "description": "MyBook — applicazione desktop per scrittura, organizzazione narrativa, worldbuilding, statistiche, versioning ed export",
  "main": "out/main/index.js",
  "author": "",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "dev": "electron-vite dev",
    "predev": "npm run rebuild:electron",
    "build": "electron-vite build",
    "build:win": "electron-vite build && electron-builder --win",
    "build:mac": "electron-vite build && electron-builder --mac",
    "build:linux": "electron-vite build && electron-builder --linux",
    "preview": "electron-vite preview",
    "prepreview": "npm run rebuild:electron",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "predb:migrate": "npm run rebuild:node",
    "test": "vitest run",
    "pretest": "npm run rebuild:node",
    "test:watch": "vitest",
    "pretest:watch": "npm run rebuild:node",
    "rebuild:node": "npm rebuild better-sqlite3",
    "rebuild:electron": "electron-builder install-app-deps",
    "postinstall": "npm run rebuild:electron"
  },
  "dependencies": {
    "@dnd-kit/core": "6.1.0",
    "@dnd-kit/sortable": "8.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@tiptap/core": "^2.6.6",
    "@tiptap/extension-color": "2.6.6",
    "@tiptap/extension-font-family": "2.6.6",
    "@tiptap/extension-highlight": "2.6.6",
    "@tiptap/extension-text-align": "2.6.6",
    "@tiptap/extension-text-style": "2.6.6",
    "@tiptap/extension-underline": "2.6.6",
    "@tiptap/react": "^2.6.6",
    "@tiptap/starter-kit": "^2.6.6",
    "better-sqlite3": "^11.3.0",
    "docx": "^8.5.0",
    "js-yaml": "^4.1.0",
    "jszip": "3.10.1",
    "lucide-react": "0.400.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.1",
    "reactflow": "^11.11.4",
    "uuid": "^9.0.1",
    "zod": "^3.23.8",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/typography": "0.5.13",
    "@types/better-sqlite3": "^7.6.11",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.5.4",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@types/uuid": "^9.0.8",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "electron": "^31.4.0",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "postcss": "^8.4.41",
    "tailwindcss": "^3.4.10",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vite": "^5.4.2",
    "vitest": "^2.0.5"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "allowScripts": {
    "better-sqlite3": true,
    "electron": true,
    "esbuild": true
  }
}
